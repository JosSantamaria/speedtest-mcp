# Clave de aplicación para speedtest-tracker (Laravel)
# Generar con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Base de datos
DB_CONNECTION=sqlite

# Zona horaria
TZ=America/Merida

# Puerto de la UI web de speedtest-tracker en el host
UI_PORT=8083

# Puerto del servidor MCP en el host
MCP_PORT=3100

# Schedule de pruebas automáticas (cron)
# 0 * * * * = cada hora en punto
SPEEDTEST_SCHEDULE=0 * * * *

# API key de speedtest-tracker (opcional al inicio)
# Obtener desde la UI: Settings > API > Create API Key
# Una vez obtenida, agregar aquí y reiniciar: docker compose restart mcp-server
SPEEDTEST_API_KEY=
